  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash(bash:*)",
        "hooks": [
          {
            "type": "command",
            "command": "script=$(echo '{{tool_input.command}}' | awk '{print $2}'); if [ -f \"$script\" ]; then dangerous=$(grep -E '(sudo|rm -rf /|dd if=|mkfs|fdisk|shutdown|reboot|passwd|chmod 777|chown -R|\\| *sh$|\\| *bash$)' \"$script\" 2>/dev/null || true); if [ -n \"$dangerous\" ]; then echo 'BLOCKED: Script contains dangerous commands:'; echo \"$dangerous\" | head -5; echo ''; echo 'To bypass: set CLAUDE_ALLOW_DANGEROUS=1 or move script to .claude/trusted/'; exit 1; fi; fi"
          }
        ]
      },
      {
        "matcher": "Bash(sh:*)",
        "hooks": [
          {
            "type": "command",
            "command": "script=$(echo '{{tool_input.command}}' | awk '{print $2}'); if [ -f \"$script\" ]; then dangerous=$(grep -E '(sudo|rm -rf /|dd if=|mkfs|fdisk|shutdown|reboot|passwd|chmod 777|chown -R|\\| *sh$|\\| *bash$)' \"$script\" 2>/dev/null || true); if [ -n \"$dangerous\" ]; then echo 'BLOCKED: Script contains dangerous commands:'; echo \"$dangerous\" | head -5; echo ''; echo 'To bypass: set CLAUDE_ALLOW_DANGEROUS=1 or move script to .claude/trusted/'; exit 1; fi; fi"
          }
        ]
      },
      {
        "matcher": "Bash(git commit:*)",
        "hooks": [
          {
            "type": "command",
            "command": "branch=$(git branch --show-current); if [ \"$branch\" = \"main\" ]; then echo 'Cannot commit directly to main'; exit 1; fi; files=$(git diff --cached --name-only 2>/dev/null | grep -E '\\.(env|pem|key|p12|pfx|keystore|jks|secret)$' || true); if [ -n \"$files\" ]; then echo 'WARNING: Potential secrets detected in:'; echo \"$files\"; fi"
          }
        ]
      },
      {
        "matcher": "Bash(terraform apply:*)",
        "hooks": [
          {
            "type": "command",
            "command": "ws=$(terraform workspace show 2>/dev/null || echo 'default'); echo 'Terraform workspace: '$ws"
          }
        ]
      },
      {
        "matcher": "Bash(terraform destroy:*)",
        "hooks": [
          {
            "type": "command",
            "command": "ws=$(terraform workspace show 2>/dev/null || echo 'default'); echo 'Terraform workspace: '$ws' - DESTROY'"
          }
        ]
      },
      {
        "matcher": "Bash(kubectl apply:*)",
        "hooks": [
          {
            "type": "command",
            "command": "ctx=$(kubectl config current-context 2>/dev/null || echo 'unknown'); ns=$(kubectl config view --minify --output 'jsonpath={..namespace}' 2>/dev/null || echo 'default'); echo 'kubectl context: '$ctx' | namespace: '$ns"
          }
        ]
      },
      {
        "matcher": "Bash(kubectl delete:*)",
        "hooks": [
          {
            "type": "command",
            "command": "ctx=$(kubectl config current-context 2>/dev/null || echo 'unknown'); ns=$(kubectl config view --minify --output 'jsonpath={..namespace}' 2>/dev/null || echo 'default'); echo 'kubectl DELETE context: '$ctx' | namespace: '$ns"
          }
        ]
      },
      {
        "matcher": "Bash(aws ec2 terminate-:*)",
        "hooks": [
          {
            "type": "command",
            "command": "profile=$(aws configure get profile 2>/dev/null || echo 'default'); account=$(aws sts get-caller-identity --query Account --output text 2>/dev/null || echo 'unknown'); echo 'AWS Profile: '$profile' | Account: '$account' - TERMINATE'"
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "input=$(cat); current_dir=$(echo \"$input\" | jq -r '.workspace.current_dir'); model_name=$(echo \"$input\" | jq -r '.model.display_name'); git_branch=$(cd \"$current_dir\" 2>/dev/null && git branch --show-current 2>/dev/null || echo ''); printf \"\\033[1;36m%s\\033[0m \\033[1;34m%s\\033[0m%s \\033[1;33m%s\\033[0m\" \"$model_name\" \"$(basename \"$current_dir\")\" \"$([ -n \"$git_branch\" ] && printf \" \\033[1;31m[%s]\\033[0m\" \"$git_branch\")\" \"$(date +%H:%M)\""
  },
